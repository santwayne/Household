# Database
DATABASE_URL=postgres://postgres@localhost:5432/shared_living
PUBLIC_URL=http://localhost:3000
PORT=3000
ADMIN_TOKEN=change-me            # protects /admin/pilot

# WhatsApp Business Platform (Cloud API). Without WA_ACCESS_TOKEN the server runs in dry-run mode (nothing is sent).
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=                   # used to verify X-Hub-Signature-256 on webhooks
WA_VERIFY_TOKEN=                 # for the GET verification handshake
WA_BUSINESS_NUMBER=91XXXXXXXXXX  # digits only; used in wa.me invite links
# Template names must be created and approved in Meta Business Manager [verify]
WA_TPL_REMINDER=food_reminder
WA_TPL_RECAP=weekly_recap

# AI (optional: without a key the bot works on rules only and says "I did not understand" otherwise)
ANTHROPIC_API_KEY=
# or
OPENAI_API_KEY=                  # also used for voice-note transcription
LLM_PARSE_MODEL=
LLM_PRICE_IN_PER_M=1             # placeholders: set from current price list [verify]
LLM_PRICE_OUT_PER_M=5
